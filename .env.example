# Copy to .env, replace every CHANGE_ME value, then run `task validate`.

# Container images. Pin immutable tags or digests for reproducible deployments.
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest
POSTGRES_VERSION=pg18
TAILSCALE_VERSION=latest

# Tailscale. MagicDNS and HTTPS certificates must be enabled for the tailnet.
TS_HOSTNAME=bookorbit
TS_AUTHKEY=tskey-auth-CHANGE_ME
APP_URL=https://bookorbit.example-tailnet.ts.net

# Host folder mounted at /books. Use an absolute path on a server or NAS.
BOOKS_HOST_PATH=./books
PUID=1000
PGID=1000

# PostgreSQL.
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bookorbit

# Generate with:
#   openssl rand -hex 32  # JWT_SECRET
#   openssl rand -hex 16  # SETUP_BOOTSTRAP_TOKEN
JWT_SECRET=CHANGE_ME
SETUP_BOOTSTRAP_TOKEN=CHANGE_ME

# Runtime defaults.
TZ=UTC
NODE_MAX_OLD_SPACE_SIZE=2048
LIBRARY_BROWSE_ROOT=/books
DISABLE_LOCAL_AUTH=false

# Optional overrides.
# CLIENT_URL=https://bookorbit.example-tailnet.ts.net
# BOOK_DOCK_PATH=/data/book-dock
# LOG_LEVEL=info
# EMAIL_ENCRYPTION_KEY=
# MIGRATION_ENCRYPTION_KEY=
# BOOK_REQUEST_ENCRYPTION_KEY=
# GITHUB_RELEASES_TOKEN=
# OIDC_ALLOW_LOCAL_ISSUERS=false
# CSP_ALLOW_CLOUDFLARE_INSIGHTS=false
